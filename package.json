{
  "name": "forgekit-amg-astro",
  "version": "1.1.1",
  "description": "CLI para crear proyectos Astro con React, Tailwind, ESLint y Prettier",
  "bin": {
    "forgekit-amg-astro": "./bin/index.js"
  },
  "exports": {
    "./cli": "./src/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "scripts": {
    "test": "node bin/index.js install .tmp-test --no-install --ts && node -e \"require('fs').rmSync('.tmp-test',{recursive:true})\""
  },
  "keywords": [
    "astro",
    "template",
    "cli",
    "tailwind",
    "react"
  ],
  "author": "Carlos Maza",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mazagonzalez/forgekit-amg-astro.git"
  }
}
